@page "/battlelog"
@using MementoMori.Option
@using MementoMori.Ortega.Share.Data.Battle.Result
@using Newtonsoft.Json
@using MementoMori.Ortega.Share.Enums
@using static MementoMori.Ortega.Share.Masters
@inject IWritableOptions<GameConfig> GameConfig
@using MementoMori.Common.Localization
@inject IFileSaver FileSaver
@inject IJSRuntime JS
@inject IDialogService DialogService

<PageTitle>@TextResourceTable.Get("[BattleReportTitle]")</PageTitle>

<MudGrid Spacing="3">
    <MudItem xs="12" md="5" lg="4">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText>@ResourceStrings.BattleRecent</MudText>
                    <MudText Typo="Typo.caption" Class="mm-muted">@string.Format(ResourceStrings.BattleCounts, _entries.Count(Visible), _entries.Count(e => Visible(e) && e.Win), _entries.Count(e => Visible(e) && !e.Win))</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIconButton Icon="@Icons.Material.Rounded.Refresh" Size="Size.Small" OnClick="Load"/>
                    <MudMenu Icon="@Icons.Material.Rounded.DeleteSweep" Size="Size.Small" Dense="true">
                        <MudMenuItem OnClick="() => Clean(1)">@ResourceStrings.BattleLogCleanOption1Day</MudMenuItem>
                        <MudMenuItem OnClick="() => Clean(7)">@ResourceStrings.BattleLogCleanOption1Week</MudMenuItem>
                        <MudMenuItem OnClick="() => Clean(30)">@ResourceStrings.BattleLogCleanOption1Month</MudMenuItem>
                        <MudMenuItem OnClick="() => Clean(0)">@ResourceStrings.BattleLogCleanOptionAll</MudMenuItem>
                    </MudMenu>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent Class="pt-0">
                <MudChipSet T="string" @bind-SelectedValue="_filter" SelectionMode="SelectionMode.ToggleSelection" Class="mb-2">
                    @foreach (var k in _entries.Select(e => e.Kind).Distinct())
                    {
                        <MudChip T="string" Value="k" Size="Size.Small" Variant="Variant.Outlined">@k</MudChip>
                    }
                </MudChipSet>
                @if (_entries.Count == 0)
                {
                    <MudText Class="mm-muted pa-6" Align="Align.Center">@ResourceStrings.BattleEmpty</MudText>
                }
                <div class="mm-battle-list">
                    @foreach (var e in _entries.Where(Visible).Take(300))
                    {
                        <div class="mm-battle-row @(e == _selected ? "is-selected" : "")" @onclick="() => Select(e)">
                            <MudIcon Icon="@(e.Win ? Icons.Material.Rounded.EmojiEvents : Icons.Material.Rounded.Close)" Color="@(e.Win ? Color.Success : Color.Error)" Size="Size.Small"/>
                            <div class="mm-battle-main">
                                <div class="mm-battle-title">@e.Kind · @e.Target</div>
                                <div class="mm-battle-time">@e.Time.ToLocalTime().ToString("MM/dd HH:mm")</div>
                            </div>
                        </div>
                    }
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="7" lg="8">
        @if (_result == null)
        {
            <MudPaper Class="pa-8" Outlined="true">
                <MudText Class="mm-muted" Align="Align.Center">@ResourceStrings.BattlePick</MudText>
            </MudPaper>
        }
        else
        {
            var sim = _result.SimulationResult;
            var win = sim.BattleEndInfo.IsWinAttacker();
            var reports = sim.BattleCharacterReports ?? new();
            var maxDmg = Math.Max(1, reports.Max(r => r.TotalGiveDamage));
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <span style="color: var(--mud-palette-@(win ? "success" : "error"))">@(win ? ResourceStrings.BattleVictory : ResourceStrings.BattleDefeat)</span>
                            <span class="mm-muted"> · @_selected!.Kind · @_selected.Target</span>
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mm-muted">
                            @_selected.Time.ToLocalTime().ToString("ddd dd MMM HH:mm") · @string.Format(ResourceStrings.BattleEndedOnTurn, sim.BattleEndInfo.EndTurn)@(sim.BattleEndInfo.IsOutOfTurn ? $" ({ResourceStrings.BattleOutOfTurns})" : "")
                        </MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Size="Size.Small" Variant="@(_replay ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.PlayCircle" OnClick="ToggleReplay">@ResourceStrings.BattleReplay</MudButton>
                        <MudTooltip Text="@ResourceStrings.BattleDownload">
                            <MudIconButton Icon="@Icons.Material.Rounded.Download" Size="Size.Small" OnClick="Download"/>
                        </MudTooltip>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    @foreach (var side in new[] {BattleFieldCharacterGroupType.Attacker, BattleFieldCharacterGroupType.Receiver})
                    {
                        var team = reports.Where(r => r.GroupType == side).OrderByDescending(r => r.TotalGiveDamage).ToList();
                        if (team.Count == 0) continue;
                        <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">
                            @(side == BattleFieldCharacterGroupType.Attacker ? ResourceStrings.BattleYourTeam : ResourceStrings.BattleEnemy)
                            <span class="mm-muted"> · @string.Format(ResourceStrings.BattleAliveDamage, team.Count(r => r.Hp > 0), team.Count, Short(team.Sum(r => r.TotalGiveDamage)))</span>
                        </MudText>
                        <MudSimpleTable Dense="true" Hover="true" Class="mb-4 mm-battle-table">
                            <thead><tr><th>@ResourceStrings.BattleUnit</th><th>@ResourceStrings.BattleDamageDealt</th><th class="mm-num">@ResourceStrings.BattleTaken</th><th class="mm-num">@ResourceStrings.BattleHealed</th><th class="mm-num">@ResourceStrings.BattleHpLeft</th></tr></thead>
                            <tbody>
                            @foreach (var r in team)
                            {
                                var hpPct = r.MaxHp > 0 ? (double) r.Hp / r.MaxHp * 100 : 0;
                                <tr class="@(r.Hp <= 0 ? "mm-dead" : "")">
                                    <td>
                                        <div class="mm-unit-name">@UnitName(r)</div>
                                        <div class="mm-muted mm-unit-sub">Lv @r.CharacterLevel · @TextResourceTable.Get(r.ElementType)@(string.IsNullOrEmpty(r.PlayerName) ? "" : " · " + r.PlayerName)</div>
                                    </td>
                                    <td style="min-width: 140px">
                                        <div class="mm-num">@Short(r.TotalGiveDamage)</div>
                                        <MudProgressLinear Value="@((double) r.TotalGiveDamage / maxDmg * 100)" Color="@(side == BattleFieldCharacterGroupType.Attacker ? Color.Primary : Color.Error)" Rounded="true" Size="Size.Small"/>
                                    </td>
                                    <td class="mm-num">@Short(r.TotalReceiveDamage)</td>
                                    <td class="mm-num">@Short(r.TotalHpRecovery)</td>
                                    <td class="mm-num">@(r.Hp <= 0 ? ResourceStrings.BattleDead : $"{hpPct:0}%")</td>
                                </tr>
                            }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudCardContent>
            </MudCard>
        }
    </MudItem>

    @if (_replay && _result != null)
    {
        <MudItem xs="12">
            <MudCard Class="mm-replay"><iframe id="log_viewer" src="https://mentemori.icu/battle_log.html" title="@ResourceStrings.BattleReplay"></iframe></MudCard>
        </MudItem>
    }
</MudGrid>

<style>
    .mm-battle-list { max-height: 70vh; overflow-y: auto; margin: 0 -8px; }
    .mm-battle-row { display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: 8px; cursor: pointer; }
    .mm-battle-row:hover { background: var(--mud-palette-action-default-hover); }
    .mm-battle-row.is-selected { background: color-mix(in srgb, var(--mud-palette-primary) 16%, transparent); }
    .mm-battle-main { min-width: 0; }
    .mm-battle-title { font-weight: 600; font-size: .875rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mm-battle-time { font-size: .75rem; color: var(--mud-palette-text-secondary); font-variant-numeric: tabular-nums; }
    .mm-battle-table .mm-num { text-align: right; font-variant-numeric: tabular-nums; }
    .mm-unit-name { font-weight: 600; }
    .mm-unit-sub { font-size: .75rem; }
    .mm-dead { opacity: .5; }
    .mm-unit-name, .mm-unit-sub { white-space: nowrap; }
    /* 手机上只留 角色 / 伤害 / 剩余 HP */
    @@media (max-width: 600px) {
        .mm-battle-table th:nth-child(3), .mm-battle-table td:nth-child(3), .mm-battle-table th:nth-child(4), .mm-battle-table td:nth-child(4) { display: none; }
        .mm-battle-table td:nth-child(2) { min-width: 96px !important; }
    }
    .mm-replay { overflow: hidden; }
    .mm-replay iframe { width: 100%; height: 800px; border: none; display: block; }
</style>

@code {
    record Entry(string File, string Kind, string Target, bool Win, DateTimeOffset Time);

    // 文件名: {prefix}-{middle}-{win|lose}-{startMs}-{token}.json, middle 可能带 '-' (比如 "5-28")
    static (string prefix, string kind)[] Kinds => new[]
    {
        ("main-", ResourceStrings.BattleMainQuest), ("tower-Infinite-", TextResourceTable.Get(TowerType.Infinite)), ("tower-Blue-", TextResourceTable.Get(TowerType.Blue)),
        ("tower-Red-", TextResourceTable.Get(TowerType.Red)), ("tower-Green-", TextResourceTable.Get(TowerType.Green)), ("tower-Yellow-", TextResourceTable.Get(TowerType.Yellow)),
        ("battleleague-", TextResourceTable.Get("[CommonHeaderLocalPvpLabel]")), ("legendleague-", TextResourceTable.Get("[CommonHeaderGlobalPvpLabel]"))
    };

    List<Entry> _entries = new();
    Entry? _selected;
    BattleResult? _result;
    string? _filter;
    bool _replay, _sendReplay;

    bool Visible(Entry e) => _filter == null || e.Kind == _filter;

    protected override void OnInitialized()
    {
        Load();
        if (_entries.Count > 0) Select(_entries[0]);
    }

    void Load()
    {
        _entries.Clear();
        var dir = GameConfig.Value.BattleLogDir;
        if (!Directory.Exists(dir)) return;
        foreach (var path in Directory.GetFiles(dir, "*.json"))
        {
            var name = Path.GetFileNameWithoutExtension(path);
            var kind = Kinds.FirstOrDefault(k => name.StartsWith(k.prefix));
            if (kind.prefix == null) continue;
            var parts = name[kind.prefix.Length..].Split('-');
            if (parts.Length < 4 || !long.TryParse(parts[^2], out var ms)) continue;
            var target = string.Join('-', parts[..^3]);
            _entries.Add(new Entry(path, kind.kind, string.IsNullOrEmpty(target) ? "?" : target, parts[^3] == "win", DateTimeOffset.FromUnixTimeMilliseconds(ms)));
        }

        _entries = _entries.OrderByDescending(e => e.Time).ToList();
    }

    void Select(Entry e)
    {
        _selected = e;
        try
        {
            _result = JsonConvert.DeserializeObject<BattleResult>(File.ReadAllText(e.File));
            _sendReplay = _replay;
        }
        catch
        {
            _result = null;
        }
    }

    string ViewerJson() => JsonConvert.SerializeObject(new {BattleSimulationResult = _result!.SimulationResult});

    async Task Download()
    {
        if (_result == null || _selected == null) return;
        await FileSaver.SaveFile(ViewerJson(), Path.GetFileName(_selected.File));
    }

    // 内嵌 mentemori.icu 的逐回合回放, 选中别的战斗时自动换
    void ToggleReplay() => (_replay, _sendReplay) = (!_replay, !_replay);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_sendReplay || _result == null) return;
        _sendReplay = false;
        await JS.InvokeVoidAsync("showBattleLog", ViewerJson());
    }

    async Task Clean(int days)
    {
        var threshold = days == 0 ? DateTimeOffset.MaxValue : DateTimeOffset.Now.AddDays(-days);
        var files = _entries.Where(e => e.Time < threshold).Select(e => e.File).ToList();
        if (files.Count == 0)
        {
            await DialogService.ShowMessageBox(ResourceStrings.BattleLogCleanRange, ResourceStrings.BattleLogNoFilesToClean);
            return;
        }

        var size = files.Sum(f => new FileInfo(f).Length);
        var ok = await DialogService.ShowMessageBox(ResourceStrings.BattleLogCleanRange,
            string.Format(ResourceStrings.BattleLogCleanConfirm, files.Count, $"{size / 1024d / 1024:0.##} MB"),
            yesText: ResourceStrings.Confirm, cancelText: ResourceStrings.Cancel);
        if (ok != true) return;

        foreach (var f in files) File.Delete(f);
        if (_selected != null && !File.Exists(_selected.File)) (_selected, _result) = (null, null);
        Load();
    }

    static string UnitName(BattleCharacterReport r)
    {
        var key = r.UnitType switch
        {
            UnitType.Character or UnitType.ShareCharacter => null,
            UnitType.BossBattleEnemy => BossBattleEnemyTable.GetById(r.UnitId)?.NameKey,
            UnitType.AutoBattleEnemy => AutoBattleEnemyTable.GetById(r.UnitId)?.NameKey,
            UnitType.TowerBattleEnemy => TowerBattleEnemyTable.GetById(r.UnitId)?.NameKey,
            UnitType.GuildTowerEnemy => GuildTowerEnemyTable.GetById(r.UnitId)?.NameKey,
            _ => null
        };
        if (r.UnitType is UnitType.Character or UnitType.ShareCharacter) return CharacterTable.GetById(r.UnitId) is { } mb ? TextResourceTable.Get(mb.NameKey) : r.UnitId.ToString();
        return key != null ? TextResourceTable.Get(key) : $"{r.UnitType} #{r.UnitId}";
    }

    static string Short(long v) => v >= 1_000_000 ? $"{v / 1_000_000d:0.#}M" : v >= 1_000 ? $"{v / 1_000d:0.#}K" : v.ToString();
}
